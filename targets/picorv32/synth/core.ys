# read generic RTL, set the requested experiment parameters, then map it to ECP5 cells
yosys read_verilog -sv $::env(PICORV32_SOURCE)
yosys read_verilog -sv $::env(PQC_PCPI_SOURCE)
yosys read_verilog -sv $::env(PQC_CORE_SOURCE)
# chparam specializes module parameters before unused instruction paths are removed
yosys chparam -set STOCK_MUL $::env(STOCK_MUL) pqc_picorv32_core_top
if {$::env(ENABLE_FQMUL)} {
    yosys chparam -set ENABLE_FQMUL 1 pqc_picorv32_core_top
}
if {$::env(ENABLE_RED32)} {
    yosys chparam -set ENABLE_RED32 1 pqc_picorv32_core_top
}
if {$::env(ENABLE_FSRI)} {
    yosys chparam -set ENABLE_FSRI 1 pqc_picorv32_core_top
    if {[info exists ::env(FSRI_IMPL)]} {
        yosys chparam -set FSRI_IMPL $::env(FSRI_IMPL) pqc_picorv32_core_top
    }
}
# hierarchy rejects missing modules and chooses the core wrapper as the synthesis root
yosys hierarchy -check -top pqc_picorv32_core_top
# synth_ecp5 lowers generic logic to LUT4/FF/DSP/BRAM cells and writes nextpnr's JSON netlist
yosys synth_ecp5 -top pqc_picorv32_core_top -json $::env(SYNTH_JSON)
