{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PQC_POLY_LTO": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "asan and ubsan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PQC_POLY_LTO": "OFF",
        "PQC_POLY_SANITIZE": "ON"
      }
    },
    {
      "name": "picorv32-sim",
      "displayName": "pinned picorv32 simulation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/picorv32-sim",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PQC_POLY_LTO": "OFF",
        "PQC_POLY_PICORV32": "ON"
      }
    },
    {
      "name": "picorv32-experiment",
      "displayName": "complete pinned picorv32 experiment",
      "inherits": "picorv32-sim",
      "binaryDir": "${sourceDir}/build/picorv32-experiment",
      "cacheVariables": {
        "PQC_POLY_PICORV32_MLKEM": "ON",
        "PQC_POLY_PICORV32_FORMAL": "ON",
        "PQC_POLY_PICORV32_SYNTHESIS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "picorv32-sim",
      "configurePreset": "picorv32-sim",
      "targets": ["pqc-picorv32-sim"]
    },
    {
      "name": "picorv32-formal",
      "configurePreset": "picorv32-experiment",
      "targets": ["pqc-picorv32-formal"]
    },
    {
      "name": "picorv32-synthesis",
      "configurePreset": "picorv32-experiment",
      "targets": ["pqc-picorv32-synthesis"]
    },
    {
      "name": "picorv32-results",
      "configurePreset": "picorv32-experiment",
      "targets": ["pqc-picorv32-results"]
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
